{% set chartData = params.dataSource %} 
<style>
    table.charts-css.bar {
  --labels-size:120px;
}
    </style>
<table class="charts-css bar show-labels show-heading" id="bar-chart">
    <caption>{{params.title}}</caption>

    <thead>
        <tr>
            {% for header in chartData %}
                <th scope="col">{{header.rowHeader}}</th>
            {% endfor %}
        </tr>
    </thead>
    <tbody>
        {% for row in chartData %}
        <tr>
            <th scope="row">{{row.acronym}}</th>
            <td style="--size: {{row.relative_value}}">
                {{row.graphValue}} <span class="tooltip">{{row.agency}}</span></td>
        </tr>
        {% endfor %}
    </tbody>
</table>